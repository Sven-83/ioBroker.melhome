{
    "i18n": true,
    "type": "panel",
    "items": {
        "_headerAccount": {
            "type": "header",
            "text": "MELCloud Home account",
            "size": 2
        },
        "email": {
            "type": "text",
            "label": "E-mail",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "type": "password",
            "label": "Password",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerConnection": {
            "type": "header",
            "text": "Connection",
            "size": 2,
            "newLine": true
        },
        "realtime": {
            "type": "checkbox",
            "label": "Real-time updates (WebSocket)",
            "help": "Polling is used as fallback if the real-time connection fails",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "pollInterval": {
            "type": "number",
            "label": "Polling interval",
            "help": "Seconds, minimum 60",
            "min": 60,
            "max": 3600,
            "step": 1,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerDashboard": {
            "type": "header",
            "text": "Dashboard",
            "size": 2,
            "newLine": true
        },
        "_dashboardHint": {
            "type": "staticText",
            "text": "The dashboard is served by the web adapter at /melcloudhome/index.html",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "roomIcons": {
            "type": "table",
            "label": "Room icons",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6,
            "noDelete": false,
            "items": [
                {
                    "type": "selectSendTo",
                    "attr": "unit",
                    "title": "Unit",
                    "command": "getUnits",
                    "jsonData": "{}",
                    "width": "60%",
                    "noTranslation": true
                },
                {
                    "type": "select",
                    "attr": "icon",
                    "title": "Icon",
                    "width": "40%",
                    "default": "auto",
                    "options": [
                        {
                            "label": "Automatic",
                            "value": "auto"
                        },
                        {
                            "label": "Armchair (living room)",
                            "value": "armchair"
                        },
                        {
                            "label": "Bed (bedroom)",
                            "value": "bed"
                        },
                        {
                            "label": "Desk (office)",
                            "value": "desk"
                        },
                        {
                            "label": "Table (dining room)",
                            "value": "dining"
                        },
                        {
                            "label": "Teddy bear (nursery)",
                            "value": "child"
                        },
                        {
                            "label": "Indoor unit",
                            "value": "unit"
                        }
                    ]
                }
            ]
        }
    }
}
