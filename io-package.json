    "native": {
        "email": "",
        "password": "",
        "pollInterval": 60,
        "realtime": true
    },
    "encryptedNative": [
        "password"
    ],
    "protectedNative": [
        "email",
        "password"
    ],
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Connected to MELCloud Home",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "info.realtime",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Real-time connection (WebSocket) open",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
